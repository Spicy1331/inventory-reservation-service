# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inventory_reservation

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=1h

# Reservation
RESERVATION_TTL_MINUTES=10

# Cron
EXPIRY_CRON_INTERVAL=*/30 * * * * *
